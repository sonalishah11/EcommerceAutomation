<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org">

<!-- यहाँ suites स्तर पर parallel="tests" किया गया है ताकि दोनों ब्राउज़र एक साथ खुलें -->
<suite name="Cross Browser Suite" parallel="tests" thread-count="2">

    <groups>
        <run>
            <include name="smoke"/>
        </run>
    </groups>

    <listeners>
        <listener class-name="com.ecommerce.listeners.TestListener"/>
        <listener class-name="com.ecommerce.listeners.AnnotationTransformer"/>
    </listeners>

    <!-- पहला टेस्ट ब्लॉक: यह सिर्फ Chrome पर चलेगा -->
    <test name="Chrome Tests">
        <parameter name="xmlBrowser" value="chrome"/>
        <classes>
            <class name="com.ecommerce.tests.LoginTest"/>
        </classes>
    </test>

    <!-- दूसरा टेस्ट ब्लॉक: यह सिर्फ Edge पर चलेगा -->
    <test name="Edge Tests">
        <parameter name="xmlBrowser" value="edge"/>
        <classes>
            <class name="com.ecommerce.tests.LoginTest"/>
        </classes>
    </test>

</suite>
